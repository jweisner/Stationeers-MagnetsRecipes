<?xml version="1.0" encoding="utf-8"?>
<GameData xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
  <AdvancedFurnaceRecipes>

    <!--
    Methane pyrolysis, carbon-seeded: CH4 -> C + 2 H2.
    Smelted charcoal acts as the carbon bed. Each charcoal in gives 2 out (net +1), and
    RequiredMix is removed per OUTPUT, so 50 x 2 = 100 mol CH4 per net charcoal.
    H2 is added by the plugin (HydrogenPatch), not by this file.
    No Rule="Pure": furnace-made charcoal off-gases CO2 and Pollutant every time it is smelted.
    No Energy (endothermic heat) cost: playtesting showed the furnace already loses plenty of heat
    holding methane at 1100 K, so an extra cost is not needed.
    -->
    <RecipeData>
      <PrefabName>ItemCharcoal</PrefabName>
      <Recipe>
        <Carbon>1</Carbon>
        <Temperature>
          <Start>1100</Start>
          <Stop>99999</Stop>
        </Temperature>
        <Pressure>
          <Start>100</Start>
          <Stop>99999</Stop>
        </Pressure>
        <RequiredMix>
          <Volatiles>50</Volatiles>
        </RequiredMix>
      </Recipe>
      <Output>2</Output>
    </RecipeData>

  </AdvancedFurnaceRecipes>
</GameData>
