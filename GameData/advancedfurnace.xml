<?xml version="1.0" encoding="utf-8"?>
<GameData xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
  <AdvancedFurnaceRecipes>

    <!--
    Methane pyrolysis, carbon-seeded: CH4 -> C + 2 H2.
    The plugin (MethanePatch) grows a carbon-only bed while the mold is closed, consuming methane
    and releasing hydrogen as it goes. This recipe only turns the grown bed back into charcoal,
    1 Carbon -> 1 charcoal, when the mold is opened under the same conditions.
    -->
    <RecipeData>
      <PrefabName>ItemCharcoal</PrefabName>
      <Recipe>
        <Carbon>1</Carbon>
        <Temperature>
          <Start>1100</Start>
          <Stop>99999</Stop>
        </Temperature>
        <Pressure>
          <Start>100</Start>
          <Stop>99999</Stop>
        </Pressure>
      </Recipe>
      <Output>1</Output>
    </RecipeData>

  </AdvancedFurnaceRecipes>
</GameData>
